# Archivos del sistema
.DS_Store
._*

# Temporales de editores
*.swp
*.swo
*~

# Entornos y secretos locales
.env
.env.*
!.env.example

# Registros y temporales de herramientas
*.log
tmp/
temp/

# Configuración local de editores
.idea/

# Documentos comerciales, económicos o con datos personales
**/factura*
**/facturas/**
**/invoice*
**/presupuesto*
**/pedido*
**/*datos-personales*
**/*personal*
**/*confidencial*

# Vídeos y otros medios audiovisuales no destinados al repositorio
**/*.mp4
**/*.mov
**/*.m4v
**/*.avi

# Desarrollo 3D privado; sólo se exponen las ediciones expresamente autorizadas
/03_pendientes/disenos-3d/*
!/03_pendientes/disenos-3d/README.md
!/03_pendientes/disenos-3d/soporte-biobolas-cradle/
/03_pendientes/disenos-3d/soporte-biobolas-cradle/*
!/03_pendientes/disenos-3d/soporte-biobolas-cradle/README.md
!/03_pendientes/disenos-3d/soporte-biobolas-cradle/soporte-biobolas.FCStd
!/03_pendientes/disenos-3d/soporte-biobolas-cradle/*.3mf
!/03_pendientes/disenos-3d/soporte-biobolas-cradle/modelo-colores.png
/03_pendientes/reconstruccion-espacial/

# Edición pública del rebosadero autorizada por el propietario
!/03_pendientes/disenos-3d/rebosadero/
/03_pendientes/disenos-3d/rebosadero/*
!/03_pendientes/disenos-3d/rebosadero/README.md
!/03_pendientes/disenos-3d/rebosadero/rebosadero.FCStd
!/03_pendientes/disenos-3d/rebosadero/estructura.3mf
!/03_pendientes/disenos-3d/rebosadero/placa-20mm.3mf
!/03_pendientes/disenos-3d/rebosadero/modelo-colores.png

# Edición pública de AI-16 Shade autorizada por el propietario
!/03_pendientes/disenos-3d/ai-16-shade/
/03_pendientes/disenos-3d/ai-16-shade/*
!/03_pendientes/disenos-3d/ai-16-shade/README.md
!/03_pendientes/disenos-3d/ai-16-shade/ai-16-shade.FCStd
